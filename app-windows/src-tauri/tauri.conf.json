{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDiskIsFull",
  "mainBinaryName": "MyDiskIsFull",
  "identifier": "io.github.lgibelli.mydiskisfull",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyDiskIsFull",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Says when the disk will be full, and what fills it",
    "copyright": "AGPL-3.0-or-later",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwODA5MzJBQzA3MEJBQ0EKUldUS3VuREFLcE9BOEIrYlZvSDJOOG5DTThHL2tYWFA1Wk9pdk1VdXZxeUMzQ1I4bTd5WFJ0akEK",
      "endpoints": [
        "https://github.com/lgibelli/mydiskisfull/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
