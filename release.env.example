# release.env.example: signing configuration for app/build.sh.
#
# Copy it to release.env (gitignored) and fill it in, or export the variables
# in your shell. Without either, the app is signed adhoc, which is fine to try
# it but means macOS forgets its Full Disk Access and notification permission
# on every rebuild.

# Your Apple Developer Team ID (10 characters). app/build.sh signs with the
# "Developer ID Application" identity of this team from your keychain.
TEAM_ID="YOURTEAMID"

# Or name the identity outright, e.g. an Apple Development certificate:
# CODESIGN_IDENTITY="Apple Development: You (TEAMID)"

# Releases (app/release.sh) are notarized. A notarytool keychain profile,
# created once with:
#   xcrun notarytool store-credentials "mydiskisfull-notary" \
#     --apple-id "you@example.com" --team-id "$TEAM_ID" \
#     --password "<app-specific password>"
# A profile you already have for another app works too. In CI, set
# APPLE_API_KEY_PATH, APPLE_API_KEY_ID and APPLE_API_ISSUER instead.
NOTARY_PROFILE="mydiskisfull-notary"

# Updates are signed with an Ed25519 key that Sparkle's generate_keys keeps in
# the login keychain (account io.github.lgibelli.mydiskisfull; app/sparkle.sh).
# In CI, SPARKLE_PRIVATE_KEY_FILE points at an exported copy instead.
